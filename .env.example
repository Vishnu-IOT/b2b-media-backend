NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=b2b_media
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Set to false to disable POST /api/auth/register (Super Admin then creates business users)
ALLOW_PUBLIC_REGISTRATION=true

# Used by seeders/01-super-admin.js
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123

# --- Email (OTP + newsletter) ---
# If SMTP_HOST/SMTP_USER/SMTP_PASS are left blank, emails are logged to the console instead of
# actually being sent — useful for local development without real mail credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vartha <no-reply@example.com>"

OTP_EXPIRES_MIN=10
# Used to build links inside emails (resource post link, unsubscribe link)
FRONTEND_URL=http://localhost:3000
# Where the "Open admin panel" button in the welcome email points to.
# Leave blank to default to FRONTEND_URL + /login
ADMIN_PANEL_URL=
# Shown as the small header label in every email template
EMAIL_BRAND_NAME="Vartha"
